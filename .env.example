# 可选：也可以直接在留文设置页配置。
SUMMARY_PROVIDER=gemini
SUMMARY_PROTOCOL=gemini_openai
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=replace-with-your-own-key

# SenseNova（可选）：通过商汤平台接入已开通的模型，例如 DeepSeek V4 Flash。
# SUMMARY_PROVIDER=sensenova
# SUMMARY_PROTOCOL=sensenova_native
# OPENAI_BASE_URL=https://api.sensenova.cn/v1/llm
# OPENAI_MODEL=deepseek-v4-flash
# SENSENOVA_API_TOKEN=replace-with-your-sensenova-api-token
# 兼容旧配置名：SENSENOVA_API_KEY=replace-with-your-sensenova-api-token

# 可选：覆盖源码开发模式的数据目录。
# WENL_DATA_DIR=C:\Users\YourName\AppData\Local\WENL Scribe\data

# 可选：开发环境使用非默认前端端口时，逗号分隔加入允许的页面来源。
# WENL_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
